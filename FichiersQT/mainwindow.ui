              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;L'uniformité représente la répartition des valeurs sur la plage possible (0 à 2^128). Ici les coupures se feront à chaque 1% et on compte le nb valeurs dans ce quartier.&lt;/p&gt;&lt;p&gt;Cette valeur est à l'échelle de la loi statistique du chi-carré. On à une constante de 123.2 qui est spécifique à nos 100 quartier.&lt;br/&gt;Si on est &amp;gt; 123.2 alors les valeurs sont mal réparties et si on est &amp;gt; 123.2 alors elles sont plutôt régulières.&lt;/p&gt;&lt;p&gt;Attention, cette valeur n'est pas totalement fiable suivant le nb de valeurs étudiées&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="styleSheet">
               <string notr="true">QLabel {
    background-color: #0078D7;
    color: white;
    font-weight: bold;
    font-size: 8px;
    border-radius: 7px; 
    padding: 0px;
    margin: 0px;
  }</string>
              </property>
              <property name="text">
               <string>   i</string>
              </property>
