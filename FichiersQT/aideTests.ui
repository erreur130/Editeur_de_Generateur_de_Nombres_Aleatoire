<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AideTests</class>
 <widget class="QDialog" name="AideTests">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>761</width>
    <height>495</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Dialog</string>
